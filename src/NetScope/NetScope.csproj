<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>netscope</AssemblyName>
    <RootNamespace>NetScope</RootNamespace>
    <!-- CI sets the version from the tag (v1.1.0 -> 1.1.0). -->
    <Version>1.2.0</Version>
    <!-- The version option prints "1.0.0", not "1.0.0+commit-hash". -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>NetScope</Product>
    <Description>Console static analyzer for .NET assemblies</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Framework-dependent dev runs may use a newer runtime than net8.0. -->
    <RollForward>Major</RollForward>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- dotnet tool: dotnet pack -c Release, then dotnet tool install -g NetScope.Tool (framework-dependent, any OS). -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>netscope</ToolCommandName>
    <PackageId>NetScope.Tool</PackageId>
    <Authors>rorythebreaker</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/rorythebreaker/netscope</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rorythebreaker/netscope</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dotnet;il;disassembler;decompiler;static-analysis;security;sarif;cli</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Release distribution: dotnet publish -c Release -r win-x64 (or linux-x64, win-arm64, linux-arm64). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.13" />
    <PackageReference Include="ICSharpCode.Decompiler" Version="11.1.0.9782" />
    <PackageReference Include="Iced" Version="1.21.0" />
    <PackageReference Include="Disarm" Version="2022.1.0-master.99" />
    <!-- Read-only managed debugger (netscope debug): ICorDebug via ClrDebug, launched through DbgShim. -->
    <PackageReference Include="ClrDebug" Version="0.4.2" />
    <PackageReference Include="Microsoft.Diagnostics.DbgShim" Version="10.0.750501" />
  </ItemGroup>

  <!-- SYSLIB1099: ClrDebug exposes classic ComImport interfaces; the source-generated COM analyzer flags the
       cast from the DbgShim callback pointer. The interop is correct and Windows-only, so the warning is muted. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);SYSLIB1099</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NetScope.Tests" />
  </ItemGroup>

</Project>

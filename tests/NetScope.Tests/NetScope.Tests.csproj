<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RollForward>Major</RollForward>
    <!-- Inline expected-value arrays keep assertions readable; tests are not performance sensitive. -->
    <NoWarn>$(NoWarn);CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Validates SARIF output against the official OASIS schema (draft-04), see Schemas/. -->
    <PackageReference Include="NJsonSchema" Version="11.6.1" />
    <!-- Compiles versions of a sample in memory for the diff tests (rebuilds, changed and shifted code). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetScope\NetScope.csproj" />
    <!-- Built first, but never loaded into the test process: it is analyzed as a file. -->
    <ProjectReference Include="..\NetScope.Samples\NetScope.Samples.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\NetScope.Samples.Hostile\NetScope.Samples.Hostile.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\NetScope.Samples.Pdb\NetScope.Samples.Pdb.csproj" ReferenceOutputAssembly="false" />
    <!-- A runnable console target the debugger tests launch (Windows only). Built first, never loaded here. -->
    <ProjectReference Include="..\NetScope.Samples.DebugTarget\NetScope.Samples.DebugTarget.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Golden\**" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <!-- ReadyToRun copy of the sample assembly for the native code tests (compiled for the build machine). -->
  <PropertyGroup>
    <SamplesR2RDir>$(MSBuildThisFileDirectory)..\NetScope.Samples\bin\r2r\$(Configuration)\</SamplesR2RDir>
  </PropertyGroup>
  <Target Name="PublishSamplesReadyToRun" BeforeTargets="Build"
          Inputs="..\NetScope.Samples\Samples.cs;..\NetScope.Samples\NetScope.Samples.csproj"
          Outputs="$(SamplesR2RDir)NetScope.Samples.dll">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\NetScope.Samples\NetScope.Samples.csproj&quot; -c $(Configuration) -r $(NETCoreSdkRuntimeIdentifier) --self-contained false -p:PublishReadyToRun=true -o &quot;$(SamplesR2RDir.TrimEnd('\'))&quot; -v q -nologo" />
  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RollForward>Major</RollForward>
    <!-- Inline expected-value arrays keep assertions readable; tests are not performance sensitive. -->
    <NoWarn>$(NoWarn);CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Validates SARIF output against the official OASIS schema (draft-04), see Schemas/. -->
    <PackageReference Include="NJsonSchema" Version="11.6.1" />
    <!-- Compiles versions of a sample in memory for the diff tests (rebuilds, changed and shifted code). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetScope\NetScope.csproj" />
    <!-- Built first, but never loaded into the test process: it is analyzed as a file. -->
    <ProjectReference Include="..\NetScope.Samples\NetScope.Samples.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\NetScope.Samples.Hostile\NetScope.Samples.Hostile.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\NetScope.Samples.Pdb\NetScope.Samples.Pdb.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Golden\**" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <!-- Reference set (TZ-NetScope-3 §3, tests/Reference/README.md): built first, analyzed as files. They target other
       frameworks, so the reference is build-order only (no framework negotiation, no output assembly). -->
  <ItemGroup>
    <ReferenceSetProject Include="..\Reference\Ref*\*.csproj;..\Reference\Ref*\*.vbproj;..\Reference\Ref*\*.fsproj;..\Reference\Ref*\*.ilproj" />
    <ProjectReference Include="@(ReferenceSetProject)" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="TargetFramework;RuntimeIdentifier" />
  </ItemGroup>

  <!-- ildasm from the Microsoft.NETCore.ILDAsm package for the build machine (Windows and Linux, x64 and ARM64). -->
  <PropertyGroup>
    <IldasmVersion>10.0.13</IldasmVersion>
    <IldasmRid>$(NETCoreSdkRuntimeIdentifier)</IldasmRid>
  </PropertyGroup>
  <ItemGroup>
    <PackageDownload Include="runtime.$(IldasmRid).Microsoft.NETCore.ILDAsm" Version="[$(IldasmVersion)]" />
    <AssemblyMetadata Include="IldasmDir" Value="$(NuGetPackageRoot)runtime.$(IldasmRid.ToLowerInvariant()).microsoft.netcore.ildasm/$(IldasmVersion)/runtimes/$(IldasmRid)/native/" />
  </ItemGroup>

  <!-- Reference assemblies 18 and 19: ReadyToRun copies of Ref02.Library for win-x64 and linux-arm64, compiled on any host. -->
  <PropertyGroup>
    <ReferenceR2RDir>$(MSBuildThisFileDirectory)..\Reference\bin\r2r\$(Configuration)\</ReferenceR2RDir>
  </PropertyGroup>
  <Target Name="PublishReferenceReadyToRun" BeforeTargets="Build"
          Inputs="..\Reference\Ref02.Library\Inventory.cs;..\Reference\Ref02.Library\Ref02.Library.csproj"
          Outputs="$(ReferenceR2RDir)win-x64\Ref02.Library.dll;$(ReferenceR2RDir)linux-arm64\Ref02.Library.dll">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\Reference\Ref02.Library\Ref02.Library.csproj&quot; -c $(Configuration) -r %(R2RRid.Identity) --self-contained false -p:PublishReadyToRun=true -o &quot;$(ReferenceR2RDir)%(R2RRid.Identity)&quot; -v q -nologo" />
  </Target>
  <ItemGroup>
    <R2RRid Include="win-x64;linux-arm64" />
  </ItemGroup>

  <!-- ReadyToRun copy of the sample assembly for the native code tests (compiled for the build machine). -->
  <PropertyGroup>
    <SamplesR2RDir>$(MSBuildThisFileDirectory)..\NetScope.Samples\bin\r2r\$(Configuration)\</SamplesR2RDir>
  </PropertyGroup>
  <Target Name="PublishSamplesReadyToRun" BeforeTargets="Build"
          Inputs="..\NetScope.Samples\Samples.cs;..\NetScope.Samples\NetScope.Samples.csproj"
          Outputs="$(SamplesR2RDir)NetScope.Samples.dll">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\NetScope.Samples\NetScope.Samples.csproj&quot; -c $(Configuration) -r $(NETCoreSdkRuntimeIdentifier) --self-contained false -p:PublishReadyToRun=true -o &quot;$(SamplesR2RDir.TrimEnd('\'))&quot; -v q -nologo" />
  </Target>

</Project>

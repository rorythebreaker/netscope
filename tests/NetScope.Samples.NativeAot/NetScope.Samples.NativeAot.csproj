<Project Sdk="Microsoft.NET.Sdk">

  <!-- NativeAOT sample (TZ-3 §4.3): published in CI with PublishAot (it needs the platform linker), never part of
       NetScope.sln. The method names are distinctive so their recovery from the image can be checked. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>AotSample</RootNamespace>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <!-- No PDB/DWARF next to the image: names must come from the image itself. -->
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <!-- The MSVC linker map lists every ILC symbol with its address: the independent reference for the addresses
       export-ghidra reads from the image (tests/Ghidra/Check-NativeAot.ps1). -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <LinkerArg Include="/MAP:&quot;$(MSBuildProjectDirectory)/$(IntermediateOutputPath)link.map&quot;" />
  </ItemGroup>

</Project>
